                "description": "True when the dimensions come from an HLPlanet review"
              },
              "review_url": {
                "type": "string",
                "description": "HLPlanet review, for measured keyboards only"
              }
            },
            "required": [
              "kind",
              "id",
              "name",
              "size",
              "keys",
              "width_mm",
              "depth_mm",
              "measured"
            ]
          },
          "items": {
