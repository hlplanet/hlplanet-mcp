    {
      "name": "check_desk_fit",
      "title": "Check desk and mousepad fit",
      "description": "Check whether a keyboard and mousepad fit side by side on a desk. The keyboard is placed with its B key in front of the screen centre (move it with keyboard_offset_cm). Returns the mouse room left, whether the pad fits or how far it hangs off, how far the mouse sits from the screen centre, and whether a full 360-degree turn at the given sensitivity (cm/360) fits on the pad.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "keyboards": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 6,
            "description": "The keyboards to place on the desk, as size names (TKL, 75%) or keyboard models. Each one is checked on its own."
          },
          "desk_width_cm": {
            "type": "number",
            "minimum": 30,
            "maximum": 400,
            "description": "Usable width of the desk surface in centimetres (inches x 2.54)."
          },
          "mousepad": {
            "type": "string",
            "enum": [
              "small",
              "medium",
              "large",
              "xl",
              "deskmat",
              "custom"
            ],
            "default": "large",
            "description": "Mousepad preset. In cm: small 25x21, medium 36x30, large 45x40, xl 49x42; a deskmat (90x40) sits under both keyboard and mouse. Use custom together with mousepad_width_cm."
          },
          "mousepad_width_cm": {
            "type": "number",
            "minimum": 5,
            "maximum": 200,
            "description": "Width of a custom mousepad in centimetres."
          },
          "cm_per_360": {
            "type": "number",
            "minimum": 1,
            "maximum": 200,
            "description": "Mouse sensitivity as cm of movement for a full 360 turn"
          },
          "left_handed": {
            "type": "boolean",
            "description": "Mouse on the left of the keyboard"
          },
          "keyboard_offset_cm": {
            "type": "number",
            "minimum": -100,
            "maximum": 100,
            "description": "How far to shift the keyboard sideways from the centred position, in cm. Negative shifts it left, positive right."
          }
        },
        "required": [
          "keyboards",
          "desk_width_cm"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "keyboard": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "size",
                        "model"
                      ],
                      "description": "\"size\" for a standard layout, \"model\" for a keyboard measured in an HLPlanet review"
                    },
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "size": {
                      "type": "string",
                      "description": "Layout size, e.g. 75%"
                    },
                    "keys": {
                      "type": "integer",
                      "description": "Number of keys"
                    },
                    "width_mm": {
                      "type": "number"
                    },
                    "depth_mm": {
                      "type": "number"
                    },
                    "measured": {
                      "type": "boolean",
                      "description": "True when the dimensions come from an HLPlanet review"
                    },
                    "review_url": {
                      "type": "string",
                      "description": "HLPlanet review, for measured keyboards only"
                    }
                  },
                  "required": [
                    "kind",
                    "id",
                    "name",
                    "size",
                    "keys",
                    "width_mm",
                    "depth_mm",
                    "measured"
                  ]
                },
                "desk_width_cm": {
                  "type": "number"
                },
                "mousepad": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "width_cm": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "type",
                    "name",
                    "width_cm"
                  ]
                },
                "left_handed": {
                  "type": "boolean"
                },
                "mouse_room_cm": {
                  "type": "number",
                  "description": "Desk width left for the mouse beside the keyboard"
                },
                "pad_fits": {
                  "type": "boolean"
                },
                "pad_spare_cm": {
                  "type": "number",
                  "description": "Room left beside the pad; negative means it hangs off the desk"
                },
                "mouse_from_screen_centre_cm": {
                  "type": "number"
                },
                "turn_360": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "cm_per_360": {
                      "type": "number"
                    },
                    "fits": {
                      "type": "boolean"
                    },
                    "short_by_cm": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "cm_per_360",
                    "fits",
                    "short_by_cm"
                  ],
                  "description": "Null when cm_per_360 was not given"
                },
                "tip": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "slide_keyboard_cm": {
                      "type": "number"
                    },
                    "direction": {
                      "type": "string",
                      "enum": [
                        "left",
                        "right"
                      ]
                    }
                  },
                  "required": [
                    "slide_keyboard_cm",
                    "direction"
                  ]
                },
                "desk_too_narrow_by_cm": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "planner_url": {
                  "type": "string",
                  "description": "The desk drawn to scale on HLPlanet"
                },
                "notes": {
                  "type": "string"
                }
              },
              "required": [
                "keyboard",
                "desk_width_cm",
                "mousepad",
                "left_handed",
                "mouse_room_cm",
                "pad_fits",
                "pad_spare_cm",
                "mouse_from_screen_centre_cm",
                "turn_360",
                "tip",
                "desk_too_narrow_by_cm",
                "planner_url",
                "notes"
              ]
            },
            "description": "One result per keyboard"
          }
        },
        "required": [
          "results"
        ]
      },
      "annotations": {
        "title": "Check desk and mousepad fit",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "which_sizes_have_key",
      "title": "Which keyboard sizes have a key",
      "description": "Check which keyboard sizes have a key or key group, e.g. \"Delete\", \"F5\", \"Insert\", \"Print Screen\", \"backtick\", \"arrow keys\", \"numpad\", \"function keys\". Returns, for each standard size from 100% to 60%, whether it has the key: yes, partly (how many keys of the group) or no. Sizes without it usually reach it through an Fn layer.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "description": "The key or key group to look up, named the way people usually call it: Delete, F12, Home, arrow keys, numpad."
          },
          "iso": {
            "type": "boolean",
            "description": "Use the ISO layout (UK/EU, tall Enter, extra key by left Shift). Default ANSI."
          }
        },
        "required": [
          "key"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "The key or key group that was looked up"
          },
          "codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "layout": {
            "type": "string",
            "enum": [
              "ANSI",
              "ISO"
            ]
          },
          "sizes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "has": {
                  "type": "string",
                  "enum": [
                    "yes",
                    "partly",
                    "no"
                  ]
                },
                "present": {
                  "type": "integer",
                  "description": "How many of the keys this size has"
                },
                "total": {
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "name",
                "has",
                "present",
                "total"
              ]
            }
          },
          "notes": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "codes",
          "layout",
          "sizes",
          "notes",
          "source"
        ]
      },
      "annotations": {
        "title": "Which keyboard sizes have a key",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "search_hlplanet",
      "title": "Search HLPlanet reviews",
      "description": "Search HLPlanet.com, a review site for Hall effect, TMR and rapid trigger keyboards, gaming controllers and gaming gear. Returns the titles and links of matching reviews, comparisons and guides, not the article text.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "description": "Search terms: a keyboard or controller model, a brand or a topic, e.g. \"Wooting 80HE\" or \"low profile hall effect\"."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 5,
            "description": "How many articles to return."
          }
        },
        "required": [
          "query"
        ],
