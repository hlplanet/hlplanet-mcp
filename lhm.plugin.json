{
  "author": "HLPlanet (https://www.hlplanet.com/)",
  "cloudEndpoint": "https://api.hlplanet.com/mcp",
  "description": "Answers keyboard size questions with measured data from HLPlanet.com: compare full-size to 60% layouts and 30 tested keyboards, check desk and mousepad fit, find which sizes keep a key, search HLPlanet reviews and list free keyboard and controller testers.",
  "homepage": "https://www.hlplanet.com/keyboard-layout/",
  "icon": "https://api.hlplanet.com/icon.png",
  "identifier": "hlplanet-hlplanet-mcp",
  "name": "HLPlanet Keyboard Sizes",
  "prompts": [],
  "resources": [],
  "tags": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "keyboard",
    "keyboard-size",
    "mechanical-keyboard",
    "hall-effect",
    "rapid-trigger",
    "gaming",
    "hlplanet"
  ],
  "tools": [
    {
      "name": "list_keyboard_sizes",
      "title": "List keyboard sizes",
      "description": "List the standard keyboard sizes (full-size 100%, 98%/1800, TKL 80%, 75%, 65%, 60%) with key count, typical dimensions, the keys each one drops compared to full-size, and who it suits. Use it for general questions like \"what keyboard sizes are there\" or \"which size should I get\".",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "sizes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "size": {
                  "type": "string"
                },
                "keys": {
                  "type": "integer"
                },
                "typical_width_mm": {
                  "type": "number"
                },
                "typical_depth_mm": {
                  "type": "number"
                },
                "narrower_than_full_size_mm": {
                  "type": "number"
                },
                "missing_vs_full_size": {
                  "type": "object",
                  "properties": {
                    "summary": {
                      "type": "string",
                      "description": "Readable list of the keys, or \"none\""
                    },
                    "count": {
                      "type": "integer"
                    },
                    "codes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Key codes, e.g. ArrowUp"
                    }
                  },
                  "required": [
                    "summary",
                    "count",
                    "codes"
                  ]
                },
                "best_for": {
                  "type": "string"
                },
                "reviews": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "url"
                    ]
                  },
                  "description": "HLPlanet reviews of keyboards in this size"
                },
                "compare_url": {
                  "type": "string",
                  "description": "This size drawn to scale on HLPlanet"
                }
              },
              "required": [
                "id",
                "name",
                "size",
                "keys",
                "typical_width_mm",
                "typical_depth_mm",
                "narrower_than_full_size_mm",
                "missing_vs_full_size",
                "best_for",
                "reviews",
                "compare_url"
              ]
            }
          },
          "compare_url": {
            "type": "string",
            "description": "All sizes drawn to scale"
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "sizes",
          "compare_url",
          "source"
        ]
      },
      "annotations": {
        "title": "List keyboard sizes",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "compare_keyboards",
      "title": "Compare keyboards",
      "description": "Compare two to six keyboard sizes or real keyboards side by side: width, depth, key count, the keys each one is missing compared to the first, and how much desk / mouse room you gain. Accepts sizes (\"TKL\", \"75%\", \"60\") and keyboards reviewed on HLPlanet (\"Wooting 60HE v2\", \"MCHOSE Jet 75\"). Known keyboards: Redragon K761 Pro, Epomaker Galaxy100, NuPhy Air100 V3, ATK x QK Hex80, Wooting 80HE, GamaKay TK75 TMR, Yunzii RT75, NuPhy Kick75, Epomaker HE75 Mag, IQUNIX EZ75, Varmilo Minilo 75, Epomaker HE75 V2 TMR, DrunkDeer G75, MCHOSE Jet 75, XVX L75 Air, NuPhy Air75 V3, Keychron K3 HE, NuPhy Air75 HE, Keydous AJ68-CP, Epomaker HE65 V2 TMR, MCHOSE Ace 68 GT, Melgeek Made68 Ultra V2, Weikav NUT65, Varmilo Muse65 HE, Wooting 60HE v2, XVX Trooper63 HE, Epomaker Hack 59, Wooting 60HE+, IQUNIX EV63, DrunkDeer G60.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "keyboards": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 2,
            "maxItems": 6,
            "description": "The keyboards to compare. The first is the baseline the others are measured against. Use size names such as TKL or 75%, or keyboard models such as Wooting 80HE."
          },
          "iso": {
            "type": "boolean",
            "description": "Use the ISO layout (UK/EU, tall Enter, extra key by left Shift). Default ANSI."
          }
        },
        "required": [
          "keyboards"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "layout": {
            "type": "string",
            "enum": [
              "ANSI",
              "ISO"
            ]
          },
          "reference": {
            "type": "object",
